rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===================================================================
    // SECURE RULES: PRIVACY-BY-DESIGN FOR PROJECT LUMNA/PHPA PLATFORM
    // ===================================================================
    
    // Helper function: Check if user is admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // ===================================================================
    // PUBLIC READ DATA (NO AUTHENTICATION REQUIRED)
    // ===================================================================
    
    // Title V facilities - public regulatory data
    match /titleVFacilities/{facilityId} {
      allow read: if true;
      allow write: if false; // Only backend can write
    }
    
    // Processed sensor readings - public environmental data
    match /processedSensorReadings/{readingId} {
      allow read: if true;
      allow write: if false; // Only backend can write
    }
    
    // Air quality data - public environmental data
    match /airQualityData/{dataId} {
      allow read: if true;
      allow write: if false; // Only backend can write
    }
    
    // ===================================================================
    // PROTECTED HEALTH DATA (SERVER-SIDE ONLY)
    // ===================================================================
    
    // Symptom reports - MUST go through Cloud Functions for validation
    match /symptomReports/{reportId} {
      // Read only aggregated/anonymized data for admins
      allow read: if isAdmin();
      // NO CLIENT WRITES - Must use submitSymptomReport Cloud Function
      allow write: if false;
    }
    
    // Health alerts - backend only
    match /healthAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend can write
    }
    
    // Rate limits - backend only
    match /rateLimits/{userId} {
      allow read: if false;
      allow write: if false; // Only backend can manage
    }
    
    // ===================================================================
    // USER PROFILES & CONSENT
    // ===================================================================
    
    // User profiles (non-PHI metadata)
    match /users/{userId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // User consent records
    match /userConsent/{userId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }
    
    // ===================================================================
    // FEEDBACK & ANALYTICS (LIMITED WRITE ACCESS)
    // ===================================================================
    
    // User feedback - authenticated users can submit
    match /userFeedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && 
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
    
    // ===================================================================
    // ADVOCACY WORKFLOW DATA
    // ===================================================================
    
    // Advocacy cases - authenticated users and advocates
    match /advocacyCases/{caseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }
    
    // Evidence attachments
    match /evidenceAttachments/{attachmentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }
    
    // ===================================================================
    // ADMIN ONLY COLLECTIONS
    // ===================================================================
    
    // System logs and audit trails
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend
    }
    
    // System configuration
    match /systemConfig/{configId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // ===================================================================
    // ANALYTICS & AGGREGATED DATA (NO PHI)
    // ===================================================================
    
    // Symptom report aggregates - aggregated data only (no PHI)
    match /symptomReportAggregates/{aggregateId} {
      allow read: if isAdmin() || isAuthenticated(); // Analysts can read aggregates
      allow write: if false; // Only backend can write
    }
    
    // Regulatory reports - admin and analysts
    match /regulatoryReports/{reportId} {
      allow read: if isAdmin() || isAuthenticated();
      allow write: if false; // Only backend can write
    }
    
    // Audit logs - admin only
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend
    }
    
    // Breach events - admin only (HIPAA requirement)
    match /breachEvents/{breachId} {
      allow read: if isAdmin();
      allow write: if false; // Only backend can write
    }
    
    // ===================================================================
    // FALLBACK: DENY ALL BY DEFAULT
    // ===================================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 