# Firebase Configuration
# Get these from Firebase Console: https://console.firebase.google.com/
REACT_APP_FIREBASE_API_KEY=your-firebase-api-key-here
REACT_APP_FIREBASE_AUTH_DOMAIN=mv-pollution-tracking-system.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=mv-pollution-tracking-system
REACT_APP_FIREBASE_STORAGE_BUCKET=mv-pollution-tracking-system.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=your-firebase-app-id-here

# Use emulators in development (set to 'true' for local development)
REACT_APP_USE_EMULATOR=true
REACT_APP_FUNCTIONS_EMULATOR_URL=http://localhost:5001/mv-pollution-tracking-system/us-central1
REACT_APP_FIRESTORE_EMULATOR_HOST=localhost:8080

# Vite Environment Variables (for Vite-based builds)
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=mv-pollution-tracking-system.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=mv-pollution-tracking-system
VITE_FIREBASE_STORAGE_BUCKET=mv-pollution-tracking-system.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=your-firebase-app-id-here
VITE_USE_EMULATOR=true

# External API Keys
# Get Mapbox token from: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Get OpenWeatherMap API key from: https://openweathermap.org/api
REACT_APP_OWM_API_KEY=your-openweather-api-key-here
VITE_OPENWEATHER_API_KEY=your-openweather-api-key-here

# Get PurpleAir API key from: contact@purpleair.com
REACT_APP_PURPLEAIR_API_KEY=your-purpleair-api-key-here

# Get IQAir API key from: https://www.iqair.com/us/air-pollution-data-api
VITE_IQAIR_API_KEY=your-iqair-api-key-here

# Azure Configuration (optional - for Azure integration)
REACT_APP_AZURE_COSMOS_CONNECTION_STRING=your-azure-cosmos-connection-string
REACT_APP_AZURE_COSMOS_DATABASE_ID=mv-pollution-tracking
REACT_APP_AZURE_CLIENT_ID=your-azure-client-id
REACT_APP_AZURE_AUTHORITY=your-azure-authority
REACT_APP_AZURE_REDIRECT_URI=your-azure-redirect-uri

# Provider selection (firebase or azure)
REACT_APP_PROVIDER=firebase
