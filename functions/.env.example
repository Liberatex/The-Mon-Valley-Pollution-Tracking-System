# EPA AQS Credentials (for official ACHD data)
# Register at: https://aqs.epa.gov/aqsweb/documents/registering.html
EPA_AQS_EMAIL=your-email@example.com
EPA_AQS_KEY=your-epa-aqs-key-here

# OpenAQ API Key (alternative data source)
# Get from: https://openaq.org/#/api
OPENAQ_API_KEY=your-openaq-api-key-here

# OpenWeatherMap API Key
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-openweather-api-key-here

# PurpleAir API Key
# Get from: contact@purpleair.com
PURPLEAIR_API_KEY=your-purpleair-api-key-here

# Admin Secret (for production deployment security)
# Generate a strong random string for production
ADMIN_SECRET=your-admin-secret-here

# Health Data Encryption Key (for HIPAA compliance)
# Generate a strong random key (32+ characters)
HEALTH_DATA_ENCRYPTION_KEY=your-encryption-key-here

# Audit Salt (for audit logging)
AUDIT_SALT=your-audit-salt-here

# Pseudo-anonymization Salt (for user data)
PSEUDO_SALT=your-pseudo-salt-here

# Azure Configuration (optional - for Azure integration)
AZURE_STORAGE_CONNECTION_STRING=your-azure-storage-connection-string
AZURE_STORAGE_ACCOUNT=mvpollutionstorage
AZURE_DATA_LAKE_CONTAINER=health-data-archive

AZURE_SYNAPSE_CONNECTION_STRING=your-azure-synapse-connection-string
AZURE_SYNAPSE_WORKSPACE=mv-pollution-synapse
AZURE_SYNAPSE_DATABASE=health_data_warehouse
AZURE_SYNAPSE_TABLE=symptom_report_aggregates

AZURE_COSMOS_CONNECTION_STRING=your-azure-cosmos-connection-string
AZURE_COSMOS_DATABASE_ID=mv-pollution-tracking

# GCP Configuration (optional - for BigQuery export)
GCP_PROJECT_ID=mv-pollution-tracking-system

# Node Environment
NODE_ENV=development
